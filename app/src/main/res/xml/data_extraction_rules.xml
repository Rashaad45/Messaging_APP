<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude everything from cloud backup and device transfer (Android 12+).
     The Room cache and Firebase auth session are device-specific; restoring them
     onto a new device would show stale data. Firestore re-syncs after sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
