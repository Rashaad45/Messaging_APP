<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 equivalent of data_extraction_rules.xml: exclude everything (see D-009). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
