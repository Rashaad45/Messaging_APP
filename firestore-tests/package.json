{
  "name": "messenger-firestore-rules-tests",
  "private": true,
  "description": "Security rules tests for firestore.rules, run against the Firestore emulator.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-messenger \"node --test --test-concurrency=1\"",
    "test:only": "node --test --test-concurrency=1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0"
  }
}
